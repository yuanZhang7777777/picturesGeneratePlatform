:8080 {
  encode zstd gzip

  header {
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "same-origin"
  }

  @django path /api /api/* /admin /admin/* /auth /auth/* /login /login/* /logout /logout/* /password /password/* /health /health/* /static /static/*
  handle @django {
    reverse_proxy web:8000
  }

  handle {
    root * /srv/frontend
    try_files {path} /index.html
    file_server
  }
}
