DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=postgres://image_platform:image_platform@postgres:5432/image_platform
USE_SQLITE_FOR_TESTS=0
APIMART_API_KEY=
APIMART_BASE_URL=https://api.apimart.ai
APIMART_FAKE_MODE=1
STORAGE_BACKEND=local
LOCAL_MEDIA_ROOT=/app/media
MAX_ACTIVE_GENERATIONS=2
ORG_DAILY_GENERATION_LIMIT=2000
USER_DAILY_GENERATION_LIMIT=100
DJANGO_CSRF_TRUSTED_ORIGINS=
