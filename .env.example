# Copy this file to .env, replace every replace-with-* value, then keep .env out of Git.
DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgres://image_platform:replace-with-a-long-random-database-password@postgres:5432/image_platform
USE_SQLITE_FOR_TESTS=0
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-an-initial-admin-password
APIMART_API_KEY=
APIMART_BASE_URL=https://api.apimart.ai/v1
APIMART_PROMPT_MODEL=deepseek-v4-pro
APIMART_VISION_MODEL=gpt-5-nano-2025-08-07
APIMART_IMAGE_MODEL=gpt-image-2
APIMART_PROMPT_TEMPERATURE=1.2
APIMART_PROMPT_TIMEOUT_SECONDS=120
APIMART_FAKE_MODE=1
PROMPT_OS_ALLOW_FALLBACK=0
ERP_LOGIN_URL=http://103.198.125.2:16777/open/system/innerOpen/login
PLATFORM_ADMIN_ERP_USERS=liuxuecheng
CATALOG_QUERY_URL=
# Comma-separated public IPv4/IPv6 literals only; hostnames and non-public IPs are rejected.
CATALOG_ALLOWED_IMAGE_HOSTS=180.167.156.35
CATALOG_TIMEOUT_SECONDS=15
CATALOG_MAX_REDIRECTS=3
CATALOG_MAX_IMAGE_BYTES=20971520
CATALOG_MAX_IMAGE_PIXELS=40000000
CATALOG_MAX_SKUS_PER_REQUEST=50
STORAGE_BACKEND=local
LOCAL_MEDIA_ROOT=/app/media
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PREFIX=independent-image-platform
MAX_ACTIVE_GENERATIONS=50
GENERATION_USER_ACTIVE_SOFT_LIMIT=10
PROMPT_WORKER_CONCURRENCY=16
GENERATION_WORKER_CONCURRENCY=32
GENERATION_PROVIDER_ACTIVE_LIMIT=500
GENERATION_QUOTAS_ENABLED=0
ORG_DAILY_GENERATION_LIMIT=2000
USER_DAILY_GENERATION_LIMIT=100
PREVIEW_PORT=18083
